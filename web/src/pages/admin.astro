---
import Layout from '../layouts/Layout.astro';
import { getAuthCookie } from '../lib/auth';
import { isAdmin } from '../lib/admin';

import { env } from "cloudflare:workers";
// Server-side admin check
const auth = await getAuthCookie(Astro.request, env.API_SECRET);

if (!auth || !isAdmin(auth.username)) {
  return Astro.redirect('/');
}
---

<Layout title="Admin" description="Admin dashboard">
  <div class="space-y-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-gray-100">Admin Dashboard</h1>
        <p class="text-gray-400 text-sm mt-1">Capacity, token health, and system status</p>
      </div>
      <button
        id="refresh-btn"
        class="p-2 bg-dark-700 hover:bg-dark-600 border border-dark-500 rounded-lg text-gray-300 hover:text-white transition-colors"
        title="Refresh all data"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
      </button>
    </div>

    <!-- Token observability -->
    <section class="bg-dark-800 border border-dark-600 rounded-xl overflow-hidden">
      <div class="px-5 py-4 border-b border-dark-600 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="flex items-center gap-3">
            <h2 class="text-lg font-semibold text-gray-100">GitHub API capacity</h2>
            <span id="capacity-status" class="rounded-full px-2.5 py-1 text-xs font-semibold bg-dark-700 text-gray-400">Collecting data</span>
          </div>
          <p id="capacity-updated" class="text-xs text-gray-500 mt-1">Hourly quota headroom across the shared token pool</p>
        </div>
        <div class="flex items-center gap-3">
          <span id="alert-status" class="text-xs text-gray-500">Checking alert setup…</span>
          <span id="capacity-check-result" role="status" aria-live="polite" class="hidden text-xs"></span>
          <button
            id="check-capacity-btn"
            class="inline-flex items-center gap-2 whitespace-nowrap px-3 py-1.5 bg-neon-purple/10 hover:bg-neon-purple/20 border border-neon-purple/40 rounded-lg text-sm text-neon-purple hover:text-white transition-colors disabled:opacity-60 disabled:cursor-wait"
          >
            <svg id="check-capacity-spinner" class="hidden animate-spin w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span id="check-capacity-label">Check now</span>
          </button>
        </div>
      </div>

      <div class="p-5 space-y-5">
        <div id="capacity-empty" class="hidden rounded-lg border border-dashed border-dark-500 px-4 py-8 text-center text-sm text-gray-400">
          No observations yet. Run a check now; the scheduled monitor will add another point every 15 minutes.
        </div>

        <div id="capacity-content" class="space-y-5">
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
            <div class="rounded-lg bg-dark-900/70 border border-dark-600 p-4">
              <div class="text-xs uppercase tracking-wide text-gray-500">Available tokens</div>
              <div id="metric-available" class="mt-2 text-2xl font-semibold text-gray-100">—</div>
              <div class="text-xs text-gray-500 mt-1">more than 4k requests left</div>
            </div>
            <div class="rounded-lg bg-dark-900/70 border border-dark-600 p-4">
              <div class="text-xs uppercase tracking-wide text-gray-500" title="Share of the requests above each token's 4k floor that are still unspent. Requests under the floor are never lent, so they don't count.">Lendable quota</div>
              <div id="metric-remaining" class="mt-2 text-2xl font-semibold text-gray-100">—</div>
              <div id="metric-remaining-detail" class="text-xs text-gray-500 mt-1">above the 4k floor</div>
            </div>
            <div class="rounded-lg bg-dark-900/70 border border-dark-600 p-4">
              <div class="text-xs uppercase tracking-wide text-gray-500" title="GitHub API requests actually spent per hour, summed across every token in the pool">API requests / hour</div>
              <div id="metric-burn" class="mt-2 text-2xl font-semibold text-gray-100">—</div>
              <div id="metric-checkouts" class="text-xs text-gray-500 mt-1">collecting a trend</div>
            </div>
            <div class="rounded-lg bg-dark-900/70 border border-dark-600 p-4">
              <div class="text-xs uppercase tracking-wide text-gray-500" title="How long the pool could keep spending at the current rate before its tokens hit the 4k-request floor. Quotas refill every hour, so anything above a few hours means usage is sustainable.">Hours until floor</div>
              <div id="metric-runway" class="mt-2 text-2xl font-semibold text-gray-100">—</div>
              <div id="metric-reset" class="text-xs text-gray-500 mt-1">before tokens hit the 4k floor</div>
            </div>
          </div>

          <div id="capacity-reasons" class="hidden rounded-lg border px-4 py-3 text-sm"></div>

          <div class="grid lg:grid-cols-3 gap-4">
            <div class="lg:col-span-2 rounded-lg bg-dark-900/50 border border-dark-600 p-4">
              <div class="flex items-start justify-between gap-3 mb-4">
                <div>
                  <h3 class="text-sm font-medium text-gray-200">Pool headroom</h3>
                  <p id="chart-subtitle" class="text-xs text-gray-500 mt-1">Percent of lendable quota (above the 4k floor) remaining · last 24 hours</p>
                </div>
                <span id="chart-range" class="text-xs text-gray-500 whitespace-nowrap">—</span>
              </div>
              <div class="relative h-52">
                <div class="absolute inset-y-0 left-0 flex flex-col justify-between text-[10px] text-gray-600 pb-5">
                  <span id="axis-top">100%</span><span id="axis-mid">50%</span><span id="axis-bottom">0%</span>
                </div>
                <svg id="quota-chart" class="w-full h-full pl-9 overflow-visible" viewBox="0 0 720 200" preserveAspectRatio="none" role="img" aria-label="Lendable GitHub quota remaining over the last 24 hours">
                  <line x1="0" y1="10" x2="720" y2="10" stroke="#27272f" />
                  <line x1="0" y1="95" x2="720" y2="95" stroke="#27272f" />
                  <line x1="0" y1="180" x2="720" y2="180" stroke="#27272f" />
                  <line id="quota-warning" x1="0" y1="0" x2="720" y2="0" stroke="#fbbf24" stroke-dasharray="5 5" opacity=".45" style="display: none"><title>Warning below 35% lendable</title></line>
                  <line id="quota-critical" x1="0" y1="0" x2="720" y2="0" stroke="#fb923c" stroke-dasharray="5 5" opacity=".6" style="display: none"><title>Critical below 15% lendable</title></line>
                  <path id="quota-area" fill="url(#quota-fill)" d=""></path>
                  <polyline id="quota-line" fill="none" stroke="#22d3ee" stroke-width="3" vector-effect="non-scaling-stroke" points=""></polyline>
                  <defs>
                    <linearGradient id="quota-fill" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#22d3ee" stop-opacity=".28"></stop>
                      <stop offset="1" stop-color="#22d3ee" stop-opacity="0"></stop>
                    </linearGradient>
                  </defs>
                </svg>
              </div>
            </div>

            <div class="rounded-lg bg-dark-900/50 border border-dark-600 p-4">
              <h3 class="text-sm font-medium text-gray-200">Token health mix</h3>
              <p class="text-xs text-gray-500 mt-1 mb-4">Latest core quota distribution</p>
              <div id="token-headroom" class="space-y-4"></div>
            </div>
          </div>

          <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
            <div class="rounded-lg bg-dark-900/70 border border-dark-600 p-4">
              <div class="text-xs uppercase tracking-wide text-gray-500" title="Active tokens currently in the lending pool">Pool size</div>
              <div id="pool-growth-total" class="mt-2 text-2xl font-semibold text-gray-100">—</div>
              <div id="pool-growth-contributors" class="text-xs text-gray-500 mt-1">—</div>
            </div>
            <div class="rounded-lg bg-dark-900/70 border border-dark-600 p-4">
              <div class="text-xs uppercase tracking-wide text-gray-500">Joined this week</div>
              <div id="pool-growth-7d" class="mt-2 text-2xl font-semibold text-gray-100">—</div>
              <div class="text-xs text-gray-500 mt-1">new tokens in the last 7 days</div>
            </div>
            <div class="rounded-lg bg-dark-900/70 border border-dark-600 p-4">
              <div class="text-xs uppercase tracking-wide text-gray-500">Joined this month</div>
              <div id="pool-growth-30d" class="mt-2 text-2xl font-semibold text-gray-100">—</div>
              <div class="text-xs text-gray-500 mt-1">new tokens in the last 30 days</div>
            </div>
            <div class="rounded-lg bg-dark-900/70 border border-dark-600 p-4">
              <div class="text-xs uppercase tracking-wide text-gray-500" title="Tokens that GitHub rejected or that could not be checked in the latest snapshot">Unusable tokens</div>
              <div id="pool-growth-invalid" class="mt-2 text-2xl font-semibold text-gray-100">—</div>
              <div id="pool-growth-invalid-detail" class="text-xs text-gray-500 mt-1">could not be checked</div>
            </div>
          </div>

          <div class="grid lg:grid-cols-2 gap-4">
            <div class="rounded-lg bg-dark-900/50 border border-dark-600 p-4">
              <div class="flex items-start justify-between gap-3 mb-4">
                <div>
                  <h3 class="text-sm font-medium text-gray-200">Pool growth</h3>
                  <p class="text-xs text-gray-500 mt-1">Active tokens by join date · last 90 days</p>
                </div>
                <span id="pool-growth-range" class="text-xs text-gray-500 whitespace-nowrap">—</span>
              </div>
              <div class="relative h-44">
                <div class="absolute inset-y-0 left-0 flex flex-col justify-between text-[10px] text-gray-600 pb-5">
                  <span id="pool-growth-axis-top">—</span><span id="pool-growth-axis-bottom">—</span>
                </div>
                <svg class="w-full h-full pl-9 overflow-visible" viewBox="0 0 720 200" preserveAspectRatio="none" role="img" aria-label="Pool size over the last 90 days">
                  <line x1="0" y1="10" x2="720" y2="10" stroke="#27272f" />
                  <line x1="0" y1="180" x2="720" y2="180" stroke="#27272f" />
                  <path id="pool-growth-area" fill="#a78bfa" fill-opacity=".14" d=""></path>
                  <polyline id="pool-growth-line" fill="none" stroke="#a78bfa" stroke-width="3" vector-effect="non-scaling-stroke" points=""></polyline>
                </svg>
              </div>
              <p class="text-xs text-gray-600 mt-2">Counts tokens still in the pool, so tokens that have since been removed are not included.</p>
            </div>

            <div class="rounded-lg bg-dark-900/50 border border-dark-600 p-4">
              <div class="flex items-start justify-between gap-3 mb-4">
                <div>
                  <h3 class="text-sm font-medium text-gray-200">Pool usage</h3>
                  <p class="text-xs text-gray-500 mt-1">Estimated GitHub API requests spent per hour · last 24 hours</p>
                </div>
                <span id="usage-range" class="text-xs text-gray-500 whitespace-nowrap">—</span>
              </div>
              <div class="relative h-44">
                <div class="absolute inset-y-0 left-0 flex flex-col justify-between text-[10px] text-gray-600 pb-5">
                  <span id="usage-axis-top">—</span><span id="usage-axis-bottom">0</span>
                </div>
                <svg class="w-full h-full pl-9 overflow-visible" viewBox="0 0 720 200" preserveAspectRatio="none" role="img" aria-label="Estimated pool API requests per hour over the last 24 hours">
                  <line x1="0" y1="10" x2="720" y2="10" stroke="#27272f" />
                  <line x1="0" y1="180" x2="720" y2="180" stroke="#27272f" />
                  <path id="usage-area" fill="#f472b6" fill-opacity=".14" d=""></path>
                  <polyline id="usage-line" fill="none" stroke="#f472b6" stroke-width="3" vector-effect="non-scaling-stroke" points=""></polyline>
                </svg>
              </div>
              <p class="text-xs text-gray-600 mt-2">Sampled from the last 3 hours of token readings, so it is smoothed and the first few hours of the window are noisier.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Legacy token burndown -->
    <section class="bg-dark-800 border border-dark-600 rounded-xl overflow-hidden">
      <div class="px-5 py-4 border-b border-dark-600 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="flex items-center gap-3">
            <h2 class="text-lg font-semibold text-gray-100">Legacy token burndown</h2>
            <span id="legacy-status" class="rounded-full px-2.5 py-1 text-xs font-semibold bg-dark-700 text-gray-400">Loading</span>
          </div>
          <p id="legacy-note" class="text-xs text-gray-500 mt-1">Tokens that still carry GitHub scopes (public_repo), retired as new no-scope tokens arrive</p>
        </div>
      </div>
      <div class="p-5 space-y-5">
        <div class="grid grid-cols-2 lg:grid-cols-6 gap-3">
          <div class="rounded-lg bg-dark-900/70 border border-dark-600 p-4">
            <div class="text-xs uppercase tracking-wide text-gray-500">Legacy tokens</div>
            <div id="legacy-rows" class="mt-2 text-2xl font-semibold text-orange-300">—</div>
            <div id="legacy-users" class="text-xs text-gray-500 mt-1">&nbsp;</div>
          </div>
          <div class="rounded-lg bg-dark-900/70 border border-dark-600 p-4">
            <div class="text-xs uppercase tracking-wide text-gray-500">Allowed now</div>
            <div id="legacy-allowed" class="mt-2 text-2xl font-semibold text-gray-100">—</div>
            <div id="legacy-cap" class="text-xs text-gray-500 mt-1">&nbsp;</div>
          </div>
          <div class="rounded-lg bg-dark-900/70 border border-dark-600 p-4">
            <div class="text-xs uppercase tracking-wide text-gray-500">To retire</div>
            <div id="legacy-excess" class="mt-2 text-2xl font-semibold text-gray-100">—</div>
            <div id="legacy-eta" class="text-xs text-gray-500 mt-1">&nbsp;</div>
          </div>
          <div class="rounded-lg bg-dark-900/70 border border-dark-600 p-4">
            <div class="text-xs uppercase tracking-wide text-gray-500">New no-scope tokens</div>
            <div id="legacy-clean" class="mt-2 text-2xl font-semibold text-green-300">—</div>
            <div class="text-xs text-gray-500 mt-1">each displaces one legacy</div>
          </div>
          <div class="rounded-lg bg-dark-900/70 border border-dark-600 p-4">
            <div class="text-xs uppercase tracking-wide text-gray-500">Retired so far</div>
            <div id="legacy-retired" class="mt-2 text-2xl font-semibold text-gray-100">—</div>
            <div class="text-xs text-gray-500 mt-1">users, grants revoked</div>
          </div>
          <div class="rounded-lg bg-dark-900/70 border border-dark-600 p-4">
            <div class="text-xs uppercase tracking-wide text-gray-500">Dead removed</div>
            <div id="legacy-dead" class="mt-2 text-2xl font-semibold text-gray-100">—</div>
            <div class="text-xs text-gray-500 mt-1">failing "bad credentials"</div>
          </div>
        </div>
        <div class="rounded-lg bg-dark-900/50 border border-dark-600 p-4">
          <div class="flex items-start justify-between gap-3 mb-3">
            <div>
              <h3 class="text-sm font-medium text-gray-200">Legacy tokens over time</h3>
              <p class="text-xs text-gray-500 mt-1"><span class="text-orange-300">Legacy</span> vs <span class="text-cyan-300">allowed</span> (cap minus new tokens) · daily snapshots</p>
            </div>
            <span id="legacy-range" class="text-xs text-gray-500 whitespace-nowrap">—</span>
          </div>
          <svg id="legacy-chart" class="w-full h-48 overflow-visible" viewBox="0 0 720 200" preserveAspectRatio="none" role="img" aria-label="Legacy tokens over time"></svg>
        </div>
        <div class="rounded-lg bg-dark-900/50 border border-dark-600 p-4">
          <div class="flex items-start justify-between gap-3 mb-3">
            <div>
              <h3 class="text-sm font-medium text-gray-200">Pool growth</h3>
              <p class="text-xs text-gray-500 mt-1"><span class="text-orange-300">Legacy</span> and <span class="text-green-300">new</span> tokens, stacked · earlier days are rebuilt from join dates, later days are daily snapshots</p>
            </div>
            <span id="growth-range" class="text-xs text-gray-500 whitespace-nowrap">—</span>
          </div>
          <svg id="growth-chart" class="w-full h-48 overflow-visible" viewBox="0 0 720 200" preserveAspectRatio="none" role="img" aria-label="Pool size over time, split into legacy and new tokens"></svg>
          <div id="growth-legend" class="mt-2 flex flex-wrap gap-4 text-xs text-gray-400"></div>
        </div>
      </div>
    </section>

    <!-- Maintenance Card -->
    <div class="bg-dark-800 border border-dark-600 rounded-lg overflow-hidden">
      <div class="px-4 py-3 flex items-center justify-between gap-4">
        <div class="flex items-center gap-6 min-w-0">
          <h2 class="text-lg font-semibold text-gray-200 whitespace-nowrap">Maintenance</h2>
          <div id="maintenance-inline-stats" class="flex items-center gap-4 text-sm flex-wrap min-w-0">
            <span class="text-gray-500">Loading...</span>
          </div>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
          <button
            id="refresh-mau-btn"
            class="px-3 py-1.5 bg-cyan-400/10 hover:bg-cyan-400/20 border border-cyan-400/40 rounded-lg text-sm text-cyan-300 hover:text-white transition-colors flex items-center gap-1"
            title="Refresh only the last two complete days of MAU rollups"
          >
            <svg id="refresh-mau-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v6h6M20 20v-6h-6M5.64 18.36A9 9 0 0018.36 5.64M18.36 5.64H14M18.36 5.64V10M5.64 18.36H10M5.64 18.36V14" />
            </svg>
            <span id="refresh-mau-text">Refresh MAU</span>
          </button>
        </div>
      </div>
      <div id="maintenance-action-output" class="hidden border-t border-dark-600 px-4 py-3">
        <pre id="maintenance-action-output-pre" class="text-xs text-gray-300 whitespace-pre-wrap break-words max-h-64 overflow-y-auto"></pre>
      </div>
    </div>

    <!-- D1 Table Counts Card -->
    <div class="bg-dark-800 border border-dark-600 rounded-lg overflow-hidden">
      <div class="px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <h2 class="text-lg font-semibold text-gray-200">D1 Table Counts</h2>
          <div id="table-counts-inline-stats" class="flex items-center gap-4 text-sm">
            <span class="text-gray-500">Loading...</span>
          </div>
        </div>
        <button
          id="table-counts-expand-btn"
          class="px-3 py-1.5 bg-dark-700 hover:bg-dark-600 border border-dark-500 rounded-lg text-sm text-gray-300 hover:text-white transition-colors flex items-center gap-1"
        >
          <span id="table-counts-expand-text">Expand</span>
          <svg id="table-counts-expand-icon" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
      </div>

      <!-- Expanded content -->
      <div id="table-counts-expanded-content" class="hidden">
        <div class="border-t border-dark-600"></div>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-dark-700">
              <tr>
                <th class="px-4 py-2 text-left text-sm font-medium text-gray-400">Table</th>
                <th class="px-4 py-2 text-right text-sm font-medium text-gray-400">Count</th>
              </tr>
            </thead>
            <tbody id="table-counts-body" class="divide-y divide-dark-600">
              <tr>
                <td colspan="2" class="px-4 py-8 text-center text-gray-500">
                  Loading...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ASDF-Primary Tools Card -->
    <div class="bg-dark-800 border border-dark-600 rounded-lg overflow-hidden">
      <div class="px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <h2 class="text-lg font-semibold text-gray-200">ASDF-Primary Tools</h2>
          <div id="asdf-inline-stats" class="flex items-center gap-4 text-sm">
            <span class="text-gray-500">Loading...</span>
          </div>
        </div>
        <button
          id="asdf-expand-btn"
          class="px-3 py-1.5 bg-dark-700 hover:bg-dark-600 border border-dark-500 rounded-lg text-sm text-gray-300 hover:text-white transition-colors flex items-center gap-1"
        >
          <span id="asdf-expand-text">Expand</span>
          <svg id="asdf-expand-icon" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
      </div>

      <!-- Expanded content -->
      <div id="asdf-expanded-content" class="hidden">
        <div class="border-t border-dark-600"></div>
        <div class="overflow-x-auto max-h-96 overflow-y-auto">
          <table class="w-full">
            <thead class="bg-dark-700 sticky top-0">
              <tr>
                <th class="px-4 py-2 text-left text-sm font-medium text-gray-400">#</th>
                <th class="px-4 py-2 text-left text-sm font-medium text-gray-400">Tool</th>
                <th class="px-4 py-2 text-right text-sm font-medium text-gray-400">30d Downloads</th>
                <th class="px-4 py-2 text-left text-sm font-medium text-gray-400">Backend</th>
              </tr>
            </thead>
            <tbody id="asdf-table-body" class="divide-y divide-dark-600">
              <tr>
                <td colspan="4" class="px-4 py-8 text-center text-gray-500">
                  Loading...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Token Pool Card (collapsible) -->
    <div class="bg-dark-800 border border-dark-600 rounded-lg overflow-hidden">
      <!-- Header with stats summary (always visible) -->
      <div class="px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <h2 class="text-lg font-semibold text-gray-200">Token Pool</h2>
          <!-- Inline stats (visible when collapsed) -->
          <div id="inline-stats" class="flex items-center gap-4 text-sm">
            <span class="text-gray-500">Loading...</span>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button
            id="delete-invalid-btn"
            class="hidden px-3 py-1.5 bg-red-900/50 hover:bg-red-900 border border-red-700 rounded-lg text-sm text-red-300 hover:text-red-100 transition-colors"
          >
            Delete Invalid Tokens
          </button>
          <button
            id="test-tokens-btn"
            class="hidden px-3 py-1.5 bg-dark-700 hover:bg-dark-600 border border-dark-500 rounded-lg text-sm text-gray-300 hover:text-white transition-colors"
          >
            Test All Tokens
          </button>
          <button
            id="expand-btn"
            class="px-3 py-1.5 bg-dark-700 hover:bg-dark-600 border border-dark-500 rounded-lg text-sm text-gray-300 hover:text-white transition-colors flex items-center gap-1"
          >
            <span id="expand-text">Expand</span>
            <svg id="expand-icon" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Expiring Tokens Alert (inside card, visible when expanded) -->
      <div id="expiring-alert" class="hidden mx-4 mb-4 bg-orange-900/20 border border-orange-500/30 rounded-lg p-4">
        <h3 class="text-orange-400 font-medium mb-2">Tokens Expiring Soon (24h)</h3>
        <div id="expiring-list" class="space-y-1"></div>
      </div>

      <!-- Expanded content -->
      <div id="expanded-content" class="hidden">
        <div class="border-t border-dark-600"></div>
        <div class="px-4 py-3 border-b border-dark-600 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex flex-1 flex-col gap-2 sm:flex-row">
            <label class="sr-only" for="token-search">Search token users</label>
            <input
              id="token-search"
              type="search"
              placeholder="Search user or display name"
              class="w-full sm:max-w-sm rounded-lg border border-dark-500 bg-dark-900 px-3 py-2 text-sm text-gray-200 placeholder:text-gray-600 focus:border-neon-purple focus:outline-none"
            />
            <label class="sr-only" for="token-filter">Filter tokens</label>
            <select
              id="token-filter"
              class="rounded-lg border border-dark-500 bg-dark-900 px-3 py-2 text-sm text-gray-300 focus:border-neon-purple focus:outline-none"
            >
              <option value="attention">Needs attention</option>
              <option value="all">All statuses</option>
              <option value="rate-limited">Rate limited</option>
              <option value="expiring">Expiring soon</option>
              <option value="invalid">Invalid</option>
            </select>
          </div>
          <span id="token-results-summary" class="text-xs text-gray-500 whitespace-nowrap">Loading…</span>
        </div>
        <div class="relative">
          <!-- Loading overlay -->
          <div id="table-loading-overlay" class="hidden absolute inset-0 bg-dark-900/70 z-10 flex items-center justify-center">
            <div class="flex flex-col items-center gap-2">
              <svg class="animate-spin h-8 w-8 text-neon-purple" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span class="text-sm text-gray-400">Testing tokens...</span>
            </div>
          </div>
          <div class="overflow-x-auto max-h-[32rem] overflow-y-auto">
            <table class="w-full">
              <thead class="bg-dark-700 sticky top-0 z-[1]">
                <tr>
                  <th class="px-4 py-2 text-left text-sm font-medium text-gray-400">User</th>
                  <th class="px-4 py-2 text-left text-sm font-medium text-gray-400">Usage</th>
                  <th class="px-4 py-2 text-left text-sm font-medium text-gray-400">Last Used</th>
                  <th class="px-4 py-2 text-left text-sm font-medium text-gray-400">Status</th>
                  <th class="px-4 py-2 text-left text-sm font-medium text-gray-400 w-20"></th>
                </tr>
              </thead>
              <tbody id="token-table-body" class="divide-y divide-dark-600">
                <tr>
                  <td colspan="5" class="px-4 py-8 text-center text-gray-500">
                    Loading...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import type { TokenObservabilityData } from '../../../src/token-observability';

  // localStorage helpers for panel state persistence
  const PANEL_STATE_KEY = 'admin-panel-state';

  function loadPanelState(): Record<string, boolean> {
    try {
      const stored = localStorage.getItem(PANEL_STATE_KEY);
      return stored ? JSON.parse(stored) : {};
    } catch {
      return {};
    }
  }

  function savePanelState(panel: string, expanded: boolean) {
    try {
      const state = loadPanelState();
      state[panel] = expanded;
      localStorage.setItem(PANEL_STATE_KEY, JSON.stringify(state));
    } catch {
      // Ignore localStorage errors
    }
  }

  type CapacityHistoryPoint = TokenObservabilityData['history'][number];
  type CapacityData = TokenObservabilityData;

  function escapeHtml(value: string): string {
    const span = document.createElement('span');
    span.textContent = value;
    return span.innerHTML;
  }

  function formatCompact(value: number): string {
    return new Intl.NumberFormat(undefined, { notation: 'compact', maximumFractionDigits: 1 }).format(value);
  }

  function setMetric(id: string, value: string, tone = 'text-gray-100') {
    const element = document.getElementById(id);
    if (!element) return;
    element.textContent = value;
    element.className = `mt-2 text-2xl font-semibold ${tone}`;
  }

  function renderQuotaChart(history: CapacityHistoryPoint[]) {
    const line = document.getElementById('quota-line');
    const area = document.getElementById('quota-area');
    const range = document.getElementById('chart-range');
    if (!line || !area || !range) return;

    const points = history.filter((point) => point.lendableLimit > 0);
    if (points.length === 0) {
      line.setAttribute('points', '');
      area.setAttribute('d', '');
      range.textContent = 'waiting for data';
      return;
    }

    const width = 720;
    const top = 10;
    const bottom = 180;
    const percents = points.map((point) => Math.max(0, Math.min(100, point.lendable / point.lendableLimit * 100)));
    // The pool usually sits near 100%, so zoom the axis to the data instead of a fixed 0-100%.
    const dip = 100 - Math.min(...percents);
    const span = [2, 5, 10, 25, 50, 100].find((step) => step >= dip * 1.2) ?? 100;
    const axisMin = 100 - span;
    const label = (value: number) => `${Number.isInteger(value) ? value : value.toFixed(1)}%`;
    document.getElementById('axis-top')!.textContent = '100%';
    document.getElementById('axis-mid')!.textContent = label(100 - span / 2);
    document.getElementById('axis-bottom')!.textContent = label(axisMin);
    const subtitle = document.getElementById('chart-subtitle');
    if (subtitle) {
      subtitle.textContent = span === 100
        ? 'Percent of lendable quota (above the 4k floor) remaining · last 24 hours'
        : `Percent of lendable quota (above the 4k floor) remaining · last 24 hours · axis zoomed to ${axisMin}–100%`;
    }
    const yFor = (percent: number) => bottom - ((percent - axisMin) / span) * (bottom - top);
    // Dashed markers for the alert thresholds, drawn only when they are on the zoomed axis.
    for (const [id, threshold] of [['quota-warning', 35], ['quota-critical', 15]] as const) {
      const marker = document.getElementById(id);
      if (!marker) continue;
      const visible = threshold >= axisMin;
      marker.style.display = visible ? '' : 'none';
      if (visible) {
        marker.setAttribute('y1', yFor(threshold).toFixed(1));
        marker.setAttribute('y2', yFor(threshold).toFixed(1));
      }
    }
    const coordinates = percents.map((percent, index) => {
      const x = points.length === 1 ? width / 2 : (index / (points.length - 1)) * width;
      return { x, y: yFor(percent) };
    });
    const pointList = coordinates.map(({ x, y }) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
    line.setAttribute('points', pointList);
    const first = coordinates[0];
    const last = coordinates[coordinates.length - 1];
    area.setAttribute('d', `M ${first.x} ${bottom} L ${pointList.replaceAll(' ', ' L ')} L ${last.x} ${bottom} Z`);

    const start = new Date(points[0].observedAt);
    const end = new Date(points[points.length - 1].observedAt);
    range.textContent = points.length === 1
      ? start.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })
      : `${start.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })} – ${end.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}`;
  }

  function renderSeries(
    prefix: string,
    series: { time: string; value: number }[],
    options: { zeroBased: boolean; format: (value: number) => string; formatTime: (time: string) => string },
  ) {
    const line = document.getElementById(`${prefix}-line`);
    const area = document.getElementById(`${prefix}-area`);
    const range = document.getElementById(`${prefix}-range`);
    const axisTop = document.getElementById(`${prefix}-axis-top`);
    const axisBottom = document.getElementById(`${prefix}-axis-bottom`);
    if (!line || !area || !range || !axisTop || !axisBottom) return;
    if (series.length === 0) {
      line.setAttribute('points', '');
      area.setAttribute('d', '');
      range.textContent = 'waiting for data';
      return;
    }

    const width = 720;
    const top = 10;
    const bottom = 180;
    const values = series.map((point) => point.value);
    const max = Math.max(...values);
    const min = Math.min(...values);
    // Growth reads better zoomed to its range; usage should anchor at zero.
    const axisMin = options.zeroBased ? 0 : Math.max(0, Math.floor(min * 0.95));
    const axisMax = max > axisMin ? max : axisMin + 1;
    const coordinates = series.map((point, index) => ({
      x: series.length === 1 ? width / 2 : (index / (series.length - 1)) * width,
      y: bottom - ((point.value - axisMin) / (axisMax - axisMin)) * (bottom - top),
    }));
    const pointList = coordinates.map(({ x, y }) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
    line.setAttribute('points', pointList);
    area.setAttribute('d', `M ${coordinates[0].x} ${bottom} L ${pointList.replaceAll(' ', ' L ')} L ${coordinates[coordinates.length - 1].x} ${bottom} Z`);
    axisTop.textContent = options.format(axisMax);
    axisBottom.textContent = options.format(axisMin);
    range.textContent = series.length === 1
      ? options.formatTime(series[0].time)
      : `${options.formatTime(series[0].time)} – ${options.formatTime(series[series.length - 1].time)}`;
  }

  function renderGrowth(data: CapacityData) {
    const { growth, summary } = data;
    const total = document.getElementById('pool-growth-total');
    if (total) total.textContent = growth.total.toLocaleString();
    const contributors = document.getElementById('pool-growth-contributors');
    if (contributors) contributors.textContent = `from ${growth.contributors.toLocaleString()} contributors`;
    const week = document.getElementById('pool-growth-7d');
    if (week) week.textContent = `+${growth.addedLast7Days.toLocaleString()}`;
    const month = document.getElementById('pool-growth-30d');
    if (month) month.textContent = `+${growth.addedLast30Days.toLocaleString()}`;
    const invalid = document.getElementById('pool-growth-invalid');
    if (invalid) {
      invalid.textContent = summary.invalidTokens.toLocaleString();
      invalid.className = `mt-2 text-2xl font-semibold ${summary.invalidTokens > 0 ? 'text-orange-300' : 'text-gray-100'}`;
    }
    const invalidDetail = document.getElementById('pool-growth-invalid-detail');
    if (invalidDetail) {
      const share = growth.total > 0 ? (summary.invalidTokens / growth.total * 100).toFixed(1) : '0';
      invalidDetail.textContent = `${share}% of the pool could not be checked`;
    }

    const dateLabel = (time: string) => new Date(`${time}T00:00:00Z`).toLocaleDateString([], { month: 'short', day: 'numeric', timeZone: 'UTC' });
    renderSeries('pool-growth', growth.series.map((point) => ({ time: point.date, value: point.tokens })), {
      zeroBased: false,
      format: (value) => Math.round(value).toLocaleString(),
      formatTime: dateLabel,
    });

    const timeLabel = (time: string) => new Date(time).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
    renderSeries(
      'usage',
      data.history.filter((point) => point.burnPerHour !== null).map((point) => ({ time: point.observedAt, value: point.burnPerHour as number })),
      { zeroBased: true, format: (value) => formatCompact(Math.round(value)), formatTime: timeLabel },
    );
  }

  function renderCapacity(data: CapacityData) {
    const { summary } = data;
    const empty = document.getElementById('capacity-empty');
    const content = document.getElementById('capacity-content');
    const hasData = Boolean(summary.observedAt);
    empty?.classList.toggle('hidden', hasData);
    content?.classList.toggle('hidden', !hasData);

    const status = document.getElementById('capacity-status');
    status?.removeAttribute('title');
    const statusStyles = {
      healthy: 'bg-green-400/10 text-green-300 border border-green-400/30',
      warning: 'bg-orange-400/10 text-orange-300 border border-orange-400/30',
      critical: 'bg-red-400/10 text-red-300 border border-red-400/30',
    };
    if (status && !hasData) {
      status.textContent = 'No data';
      status.className = 'rounded-full px-2.5 py-1 text-xs font-semibold bg-dark-700 text-gray-400';
    } else if (status) {
      status.textContent = summary.level === 'healthy' ? 'Healthy' : summary.level === 'warning' ? 'Watch' : 'Critical';
      status.className = `rounded-full px-2.5 py-1 text-xs font-semibold ${statusStyles[summary.level]}`;
    }

    const updated = document.getElementById('capacity-updated');
    if (updated && summary.observedAt) {
      updated.textContent = `Last checked ${new Date(summary.observedAt).toLocaleString()} · snapshots every 15 minutes`;
    }

    const metricTone = summary.level === 'critical' ? 'text-red-300' : summary.level === 'warning' ? 'text-orange-300' : 'text-green-300';
    setMetric(
      'metric-available',
      summary.complete
        ? `${summary.availableTokens}/${summary.tokenCount}`
        : `${summary.availableTokens}/${summary.checkedTokens} checked`,
      metricTone,
    );
    setMetric('metric-remaining', summary.lendablePercent === null ? '—' : `${summary.lendablePercent}%`, metricTone);
    const remainingDetail = document.getElementById('metric-remaining-detail');
    if (remainingDetail) {
      const coverage = summary.complete ? 'across the pool' : `across ${summary.checkedTokens} of ${summary.tokenCount} tokens`;
      remainingDetail.textContent = `${summary.lendable.toLocaleString()} of ${summary.lendableLimit.toLocaleString()} requests above the 4k floor · ${coverage}`;
    }
    setMetric('metric-burn', summary.quotaBurnPerHour === null ? 'Learning' : `${formatCompact(summary.quotaBurnPerHour)}/h`);
    const checkouts = document.getElementById('metric-checkouts');
    if (checkouts) {
      const burnPercent = summary.limit > 0 ? (summary.quotaBurnPerHour ?? 0) / summary.limit * 100 : 0;
      const burnShare = summary.quotaBurnPerHour !== null && summary.limit > 0
        ? `${burnPercent < 0.1 ? '<0.1' : burnPercent.toFixed(1)}% of the pool's ${formatCompact(summary.limit)}/h`
        : null;
      const handouts = summary.checkoutRatePerHour === null ? null : `${formatCompact(summary.checkoutRatePerHour)} tokens handed out/h`;
      checkouts.textContent = [burnShare, handouts].filter(Boolean).join(' · ') || 'needs two snapshots';
    }
    // Quotas refill hourly, so a runway beyond a day just means "sustainable".
    // A null runway is only sustainable once a burn rate has been measured.
    const runway = summary.hoursToReserve;
    const learning = summary.quotaBurnPerHour === null;
    setMetric(
      'metric-runway',
      learning ? 'Learning' : runway === null || runway > 24 ? '24h+' : `${runway}h`,
      !learning && runway !== null && runway <= 6 ? metricTone : 'text-gray-100',
    );
    const reset = document.getElementById('metric-reset');
    if (reset) {
      const refill = summary.nextResetAt ? ` · next refill ${new Date(summary.nextResetAt).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}` : '';
      reset.textContent = learning
        ? `needs two snapshots${refill}`
        : `at this rate, until tokens hit the 4k floor${refill}`;
    }

    const reasons = document.getElementById('capacity-reasons');
    if (reasons) {
      reasons.classList.toggle('hidden', summary.reasons.length === 0);
      reasons.className = `${summary.reasons.length === 0 ? 'hidden ' : ''}rounded-lg border px-4 py-3 text-sm ${summary.level === 'critical' ? 'border-red-500/30 bg-red-900/20 text-red-200' : 'border-orange-500/30 bg-orange-900/20 text-orange-200'}`;
      reasons.innerHTML = summary.reasons.map((reason) => `<div>• ${escapeHtml(reason)}</div>`).join('');
    }

    const alertStatus = document.getElementById('alert-status');
    if (alertStatus) {
      alertStatus.textContent = data.alerting.configured ? `Resend alerts → ${data.alerting.recipient}` : 'Resend alerts not configured';
      alertStatus.className = `text-xs ${data.alerting.configured ? 'text-green-400' : 'text-orange-400'}`;
    }

    const headroom = document.getElementById('token-headroom');
    if (headroom) {
      const buckets = [
        { label: 'Healthy', count: 0, color: 'bg-green-400', detail: '>35% lendable' },
        { label: 'Watch', count: 0, color: 'bg-orange-400', detail: '≤35% lendable' },
        { label: 'Below floor', count: 0, color: 'bg-red-400', detail: '≤4k requests left' },
        { label: 'Rate limited', count: 0, color: 'bg-purple-400', detail: 'locally paused' },
        { label: 'Check failed', count: 0, color: 'bg-gray-500', detail: 'quota unknown' },
      ];
      const FLOOR = 4_000;
      for (const token of data.tokens) {
        const lendable = token.remaining !== null && token.limit && token.limit > FLOOR
          ? Math.round((token.remaining - FLOOR) / (token.limit - FLOOR) * 100)
          : null;
        if (token.error || lendable === null) buckets[4].count++;
        else if (token.remaining !== null && token.remaining <= FLOOR) buckets[2].count++;
        else if (!token.available) buckets[3].count++;
        else if (lendable <= 35) buckets[1].count++;
        else buckets[0].count++;
      }
      const total = data.tokens.length;
      headroom.innerHTML = buckets.map((bucket) => {
        const percent = total === 0 ? 0 : Math.round(bucket.count / total * 100);
        return `<div>
          <div class="flex items-center justify-between gap-3 text-xs mb-1.5">
            <span class="text-gray-300">${bucket.label} <span class="text-gray-600">· ${bucket.detail}</span></span>
            <span class="font-mono text-gray-400">${bucket.count.toLocaleString()} · ${percent}%</span>
          </div>
          <div class="h-2 rounded-full bg-dark-700 overflow-hidden"><div class="h-full rounded-full ${bucket.color}" style="width: ${percent}%"></div></div>
        </div>`;
      }).join('') || '<div class="text-sm text-gray-500">No pool tokens</div>';
    }

    renderQuotaChart(data.history);
    renderGrowth(data);
  }

  const CAPACITY_CHECK_TIMEOUT_MS = 90_000;
  let capacityResultTimer: number | undefined;

  function showCapacityResult(message: string, tone: 'success' | 'warning' | 'error') {
    const result = document.getElementById('capacity-check-result');
    if (!result) return;
    window.clearTimeout(capacityResultTimer);
    result.textContent = message;
    result.className = `text-xs ${tone === 'success' ? 'text-green-400' : tone === 'warning' ? 'text-orange-400' : 'text-red-400'}`;
    // Warnings and failures stay put until the next check so they can't be missed.
    if (tone === 'success') {
      capacityResultTimer = window.setTimeout(() => result.classList.add('hidden'), 8000);
    }
  }

  function setCapacityChecking(checking: boolean) {
    const button = document.getElementById('check-capacity-btn') as HTMLButtonElement | null;
    const label = document.getElementById('check-capacity-label');
    const spinner = document.getElementById('check-capacity-spinner');
    if (button) button.disabled = checking;
    if (label) label.textContent = checking ? 'Checking…' : 'Check now';
    spinner?.classList.toggle('hidden', !checking);
    if (checking) {
      window.clearTimeout(capacityResultTimer);
      document.getElementById('capacity-check-result')?.classList.add('hidden');
    }
  }

  function describeCapacityCheck(summary: CapacityData['summary']): string {
    if (summary.tokenCount === 0) return 'Checked just now — no pool tokens configured';
    if (summary.complete) return `Checked just now — all ${summary.tokenCount} tokens`;
    return `Checked just now — ${summary.checkedTokens} of ${summary.tokenCount} tokens (the rest rotate in on later checks)`;
  }

  async function capacityErrorMessage(error: unknown, response?: Response): Promise<string> {
    if (error instanceof DOMException && error.name === 'AbortError') {
      return `Check timed out after ${CAPACITY_CHECK_TIMEOUT_MS / 1000}s`;
    }
    if (response) {
      // The route answers with {"error": "..."}, auth failures with plain text,
      // and the platform with HTML or nothing; show only what is readable.
      let body = (await response.text().catch(() => '')).trim();
      try {
        body = String(JSON.parse(body).error ?? body);
      } catch {
        // not JSON
      }
      const detail = body && !body.startsWith('<') ? `: ${body.slice(0, 200)}` : '';
      return `Check failed (HTTP ${response.status}${detail})`;
    }
    return `Check failed: ${error instanceof Error ? error.message : String(error)}`;
  }

  // Reads race with "Check now" (initial load, Refresh All, scheduled snapshots),
  // so order them by the snapshot they carry rather than by when they finished:
  // a read is dropped only if it is older than what is already on screen.
  const CAPACITY_HISTORY_WINDOW_MS = 24 * 3_600_000; // the API's HISTORY_HOURS
  let capacityDisplayedAt: string | null = null;

  function isOlderCapacityRead(observedAt: string | null): boolean {
    if (!capacityDisplayedAt) return false;
    if (observedAt) return observedAt < capacityDisplayedAt;
    // No snapshot at all: either the displayed one has aged out of the API's
    // window (show "No data"), or the read started before the first-ever check
    // wrote anything (stale, drop it).
    return Date.now() - Date.parse(capacityDisplayedAt) < CAPACITY_HISTORY_WINDOW_MS;
  }

  async function loadCapacity(runCheck = false) {
    if (runCheck) setCapacityChecking(true);
    const controller = new AbortController();
    const timeout = runCheck ? window.setTimeout(() => controller.abort(), CAPACITY_CHECK_TIMEOUT_MS) : undefined;
    let failedResponse: Response | undefined;
    try {
      const response = await fetch('/api/admin/token-observability', {
        method: runCheck ? 'POST' : 'GET',
        signal: controller.signal,
      });
      if (!response.ok) {
        failedResponse = response;
        throw new Error(`HTTP ${response.status}`);
      }
      const data: CapacityData = await response.json();
      const observedAt = data.summary.observedAt;
      if (!runCheck && isOlderCapacityRead(observedAt)) return;
      renderCapacity(data);
      capacityDisplayedAt = observedAt;
      if (runCheck) {
        const checked = describeCapacityCheck(data.summary);
        if (data.alerting.error) {
          showCapacityResult(`${checked}, but alerting failed: ${data.alerting.error.slice(0, 200)}`, 'warning');
        } else {
          showCapacityResult(checked, 'success');
        }
      }
    } catch (error) {
      console.error('capacity:', error);
      if (runCheck) {
        // Keep whatever was already on screen; just say the check didn't work.
        showCapacityResult(await capacityErrorMessage(error, failedResponse), 'error');
      } else if (capacityDisplayedAt) {
        // A snapshot is still on screen (possibly fresh from a check), so leave
        // its status alone and just flag that the refresh didn't land.
        const updated = document.getElementById('capacity-updated');
        if (updated && !updated.textContent?.includes('refresh failed')) updated.textContent += ' · refresh failed';
      } else {
        const status = document.getElementById('capacity-status');
        if (status) {
          status.textContent = 'Unavailable';
          status.className = 'rounded-full px-2.5 py-1 text-xs font-semibold bg-red-400/10 text-red-300 border border-red-400/30';
          status.title = error instanceof Error ? error.message : String(error);
        }
      }
    } finally {
      window.clearTimeout(timeout);
      if (runCheck) setCapacityChecking(false);
    }
  }

  type LegacyCurrent = {
    cap: number; poolRows: number; legacyRows: number; cleanRows: number;
    legacyUsers: number; allowedLegacy: number; excess: number; retiredUsers: number; deadRemoved: number;
  };
  type LegacySnapshot = {
    observed_at: string; legacy_rows: number; clean_rows: number; legacy_users: number;
    retired_users: number; retired_this_run: number; enabled: number; healthy: number;
  };
  type LegacyData = {
    current: LegacyCurrent;
    config: { enabled: boolean; maxPerRun: number; minPoolSize: number; minAvailableTokens: number };
    history: LegacySnapshot[];
    growth: GrowthPoint[];
  };

  function renderLegacyChart(history: LegacySnapshot[], current: LegacyCurrent) {
    const svg = document.getElementById('legacy-chart');
    const range = document.getElementById('legacy-range');
    if (!svg || !range) return;
    // Daily snapshots plus the live numbers as the final point.
    const points = [
      ...history.map((h) => ({ at: h.observed_at, legacy: h.legacy_rows, allowed: Math.max(0, current.cap - h.clean_rows) })),
      { at: new Date().toISOString(), legacy: current.legacyRows, allowed: current.allowedLegacy },
    ];
    const width = 720, top = 10, bottom = 180;
    const max = Math.max(1, ...points.flatMap((p) => [p.legacy, p.allowed]));
    const x = (i: number) => points.length === 1 ? width / 2 : (i / (points.length - 1)) * width;
    const y = (v: number) => bottom - (v / max) * (bottom - top);
    const line = (key: 'legacy' | 'allowed') => points.map((p, i) => `${x(i).toFixed(1)},${y(p[key]).toFixed(1)}`).join(' ');
    svg.innerHTML = `
      <line x1="0" y1="${top}" x2="${width}" y2="${top}" stroke="#27272f" />
      <line x1="0" y1="${(top + bottom) / 2}" x2="${width}" y2="${(top + bottom) / 2}" stroke="#27272f" />
      <line x1="0" y1="${bottom}" x2="${width}" y2="${bottom}" stroke="#27272f" />
      <polyline fill="none" stroke="#22d3ee" stroke-width="2" stroke-dasharray="6 5" vector-effect="non-scaling-stroke" points="${line('allowed')}" />
      <polyline fill="none" stroke="#fb923c" stroke-width="3" vector-effect="non-scaling-stroke" points="${line('legacy')}" />
      <text x="2" y="${top - 2}" fill="#6b7280" font-size="11">${max.toLocaleString()}</text>
      <text x="2" y="${bottom + 14}" fill="#6b7280" font-size="11">0</text>`;
    const first = new Date(points[0].at);
    const last = new Date(points[points.length - 1].at);
    range.textContent = points.length === 1
      ? 'waiting for the first daily snapshot'
      : `${first.toLocaleDateString()} – ${last.toLocaleDateString()}`;
  }

  type GrowthPoint = { day: string; legacy: number; clean: number };

  function renderGrowthChart(growth: GrowthPoint[]) {
    const svg = document.getElementById('growth-chart');
    const range = document.getElementById('growth-range');
    const legend = document.getElementById('growth-legend');
    if (!svg || !range || !legend) return;
    if (growth.length === 0) {
      svg.innerHTML = '';
      range.textContent = 'no data';
      return;
    }
    const width = 720, top = 10, bottom = 180;
    const max = Math.max(1, ...growth.map((p) => p.legacy + p.clean));
    const x = (i: number) => growth.length === 1 ? width / 2 : (i / (growth.length - 1)) * width;
    const y = (v: number) => bottom - (v / max) * (bottom - top);
    const area = (lower: (p: GrowthPoint) => number, upper: (p: GrowthPoint) => number) => {
      const forward = growth.map((p, i) => `${x(i).toFixed(1)},${y(upper(p)).toFixed(1)}`);
      const back = growth.map((p, i) => `${x(i).toFixed(1)},${y(lower(p)).toFixed(1)}`).reverse();
      return [...forward, ...back].join(' ');
    };
    const line = (value: (p: GrowthPoint) => number) =>
      growth.map((p, i) => `${x(i).toFixed(1)},${y(value(p)).toFixed(1)}`).join(' ');
    // Legacy sits on the bottom; new tokens stack on top, so the upper edge is the total.
    svg.innerHTML = `
      <line x1="0" y1="${top}" x2="${width}" y2="${top}" stroke="#27272f" />
      <line x1="0" y1="${(top + bottom) / 2}" x2="${width}" y2="${(top + bottom) / 2}" stroke="#27272f" />
      <line x1="0" y1="${bottom}" x2="${width}" y2="${bottom}" stroke="#27272f" />
      <polygon fill="#fb923c" fill-opacity=".35" points="${area(() => 0, (p) => p.legacy)}" />
      <polygon fill="#4ade80" fill-opacity=".35" points="${area((p) => p.legacy, (p) => p.legacy + p.clean)}" />
      <polyline fill="none" stroke="#fb923c" stroke-width="2" vector-effect="non-scaling-stroke" points="${line((p) => p.legacy)}" />
      <polyline fill="none" stroke="#4ade80" stroke-width="2" vector-effect="non-scaling-stroke" points="${line((p) => p.legacy + p.clean)}" />
      <text x="2" y="${top - 2}" fill="#6b7280" font-size="11">${max.toLocaleString()}</text>
      <text x="2" y="${bottom + 14}" fill="#6b7280" font-size="11">0</text>`;
    const last = growth[growth.length - 1];
    range.textContent = growth.length === 1 ? growth[0].day : `${growth[0].day} – ${last.day}`;
    legend.innerHTML = `
      <span><span class="text-orange-300">■</span> Legacy ${last.legacy.toLocaleString()}</span>
      <span><span class="text-green-300">■</span> New ${last.clean.toLocaleString()}</span>
      <span>Total ${(last.legacy + last.clean).toLocaleString()}</span>`;
  }

  function renderLegacy(data: LegacyData) {
    const { current, config } = data;
    const set = (id: string, text: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    };
    set('legacy-rows', current.legacyRows.toLocaleString());
    set('legacy-users', `${current.legacyUsers.toLocaleString()} users`);
    set('legacy-allowed', current.allowedLegacy.toLocaleString());
    set('legacy-cap', `${current.cap.toLocaleString()} cap − ${current.cleanRows.toLocaleString()} new`);
    set('legacy-excess', current.excess.toLocaleString());
    const days = current.excess > 0 ? Math.ceil(current.excess / config.maxPerRun) : 0;
    set('legacy-eta', current.excess === 0 ? 'within the allowance' : `up to ${config.maxPerRun} users/day · ~${days}+ days`);
    set('legacy-clean', current.cleanRows.toLocaleString());
    set('legacy-retired', current.retiredUsers.toLocaleString());
    set('legacy-dead', current.deadRemoved.toLocaleString());

    const status = document.getElementById('legacy-status');
    if (status) {
      status.textContent = config.enabled ? 'Retiring' : 'Off';
      status.className = `rounded-full px-2.5 py-1 text-xs font-semibold ${config.enabled ? 'bg-green-400/10 text-green-300 border border-green-400/30' : 'bg-dark-700 text-gray-400'}`;
    }
    const note = document.getElementById('legacy-note');
    if (note) {
      note.textContent = config.enabled
        ? `Daily at 04:23 UTC · skips unless the pool is not critical with ${config.minAvailableTokens}+ usable tokens · never below ${config.minPoolSize} tokens`
        : 'Disabled: set the LEGACY_SCOPE_SUNSET secret to "on" to start retiring. Snapshots are still recorded daily.';
    }
    renderLegacyChart(data.history, current);
    renderGrowthChart(data.growth);
  }

  async function loadLegacy() {
    try {
      const response = await fetch('/api/admin/legacy-tokens');
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      renderLegacy(await response.json());
    } catch (error) {
      const status = document.getElementById('legacy-status');
      if (status) {
        status.textContent = 'Unavailable';
        status.className = 'rounded-full px-2.5 py-1 text-xs font-semibold bg-red-400/10 text-red-300 border border-red-400/30';
      }
      console.error('legacy burndown:', error);
    }
  }

