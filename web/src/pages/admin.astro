      const tableCount = Object.keys(tableCountsData).length;

      // Update inline stats
      const inlineStats = document.getElementById('table-counts-inline-stats');
      if (inlineStats) {
        inlineStats.innerHTML = `
          <span class="text-neon-cyan">${tableCount} tables</span>
