---
import { LOGPUSH_MAU_WINDOW_DAYS, type LogpushAudience } from '../../../src/analytics/logpush-audience';
interface Props { audience:LogpushAudience }
const { daily, mau } = Astro.props.audience;
const latest = daily.filter(p=>!p.partial).at(-1);
const rows = daily.slice(-14).reverse();
---
<section class="adoption-chart logpush-audience" aria-labelledby="logpush-audience-heading">
  <h2 id="logpush-audience-heading">Users from Cloudflare logs (preview)</h2>
  <p class="adoption-context">Counted from Cloudflare request logs, which see every mise client, including those that read versions from static files and never reach the source of the charts above. Includes CI runs from mise clients older than v2026.10.11 (newer clients mark CI and are left out), so these numbers run higher. They replace the charts above once {LOGPUSH_MAU_WINDOW_DAYS} days are covered (~Nov 13).</p>
  <div class="adoption-metrics">
    <div><h3>DAU · {latest?.date ?? '—'}</h3><strong>{latest ? latest.dau.toLocaleString() : '—'}</strong><p>Distinct users on the latest full UTC day</p></div>
    {mau && <div><h3>MAU so far · partial</h3><strong>{mau.mau.toLocaleString()}</strong><p>{Math.min(mau.days_covered, LOGPUSH_MAU_WINDOW_DAYS)} of {LOGPUSH_MAU_WINDOW_DAYS} days covered · through {mau.date}</p></div>}
  </div>
  <details><summary>Daily values</summary><ul>{rows.map(p=><li>{p.date}: {p.dau.toLocaleString()} DAU{p.partial && ' (partial day)'}</li>)}</ul></details>
</section>
<style>.logpush-audience .adoption-metrics{grid-template-columns:repeat(2,1fr);} details{margin-top:.8rem;} summary{cursor:pointer;color:var(--muted);font-size:.8rem;} li{padding:.3rem;font-size:.8rem;} @media (max-width:640px){.logpush-audience .adoption-metrics{grid-template-columns:1fr;}}</style>
