---
import { AuthButton } from '../components/AuthButton';
import { AdminButton } from '../components/AdminButton';
import { ThemeSelect } from '../components/ThemeSelect';
import { NavSearch } from '../components/NavSearch';
import '../index.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "mise versions",
  description = "Browse tool versions and download stats for mise",
  ogImage = "https://mise-tools.jdx.dev/api/og",
} = Astro.props;

const fullTitle = title === "mise versions" ? title : `${title} | mise versions`;
const canonicalUrl = new URL(Astro.url.pathname, "https://mise-tools.jdx.dev").href;
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Language" content="en" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="mise versions" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <script is:inline>
      (() => {
        let preference = 'system';
        try { preference = localStorage.getItem('mise-theme') || 'system'; } catch {}
        document.documentElement.dataset.theme = preference === 'light' || preference === 'dark'
          ? preference : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
    </script>
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-3ZHZ3404HC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-3ZHZ3404HC');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-nav">
        <a href="/" class="wordmark" aria-label="mise versions home"><span class="brand-symbol" aria-hidden="true">m.</span><span>mise<span class="wordmark-sub"> / versions</span></span></a>
        <nav class="primary-nav" aria-label="Main navigation">
          <a href="/" aria-current={currentPath === '/' || currentPath.startsWith('/tools/') ? 'page' : undefined}>Tools</a>
          <a href="/stats" aria-current={currentPath === '/stats' ? 'page' : undefined}>Stats</a>
        </nav>
        <div class="nav-actions">
          {currentPath !== '/' && <NavSearch initialQuery={Astro.url.searchParams.get("q") || ""} client:load />}
          <ThemeSelect client:load />
          <details class="site-menu">
            <summary aria-label="Resources and account">More <span aria-hidden="true">⌄</span></summary>
            <div class="site-menu-panel">
              <a href="https://mise.jdx.dev">Documentation ↗</a>
              <a href="https://github.com/jdx/mise">mise on GitHub ↗</a>
              <a href="https://github.com/jdx/mise-versions">Site source ↗</a>
              <AdminButton client:load />
              <AuthButton client:load />
            </div>
          </details>
        </div>
      </div>
    </header>
    <main id="main" class="site-main"><slot /></main>
    <footer class="site-footer">
      <a class="wordmark" href="https://mise.jdx.dev">mise<span class="wordmark-sub"> / the front-end to your dev env</span></a>
      <div><a href="https://mise.jdx.dev/getting-started.html">Get started ↗</a><a href="https://github.com/jdx/mise-versions">Open source ↗</a></div>
    </footer>
  </body>
</html>
